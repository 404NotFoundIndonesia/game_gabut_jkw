# Application
APP_ENV=development
APP_PORT=8080
DOMAIN=your-domain.example.com

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/bot_game_management?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
ADMIN_API_KEY=change-me-admin-api-key
BOT_TOKEN_ENCRYPTION_KEY=change-me-32-byte-aes-key-here!!

# KBBI
KBBI_MODE=offline
KBBI_API_URL=

# Logging
LOG_LEVEL=info

# Session
SESSION_TTL_HOURS=168

# Telegram Webhook Integration (Phase 6)
# Token of the main admin bot from BotFather
MAIN_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to send admin commands
TELEGRAM_ADMIN_IDS=
# Public base URL where Telegram delivers webhooks (no trailing slash)
WEBHOOK_BASE_URL=https://your-domain.example.com
# Secret token validated in X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET_TOKEN=change-me-webhook-secret-token
# Redis TTL in minutes for /addbot conversation FSM state
CONV_STATE_TTL_MINUTES=10
