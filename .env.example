# Application
APP_ENV=development
APP_PORT=8080

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/bot_game_management?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
ADMIN_API_KEY=change-me-admin-api-key
BOT_TOKEN_ENCRYPTION_KEY=change-me-32-byte-aes-key-here!!

# KBBI
KBBI_MODE=offline
KBBI_API_URL=

# Logging
LOG_LEVEL=info

# Session
SESSION_TTL_HOURS=168
